              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response is JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "    pm.response.to.be.json;",
              "});",
              "",
              "const responseJson = pm.response.json();",
              "",
              "pm.test('Response contains expected title', function () {",
              "    pm.expect(responseJson.title).to.eql('My First API Test');",
              "});",
              "",
              "pm.test('Response contains expected body', function () {",
              "    pm.expect(responseJson.body).to.eql('Testing API using Postman');",
              "});",
              "",
              "pm.test('Response contains expected userId', function () {",
              "    pm.expect(responseJson.userId).to.eql(1);",
              "});",
              "",
              "pm.test('Response contains generated id', function () {",
              "    pm.expect(responseJson).to.have.property('id');",
              "    pm.expect(responseJson.id).to.exist;",
              "});"
