    {
      "name": "Update Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test('Updated post fields match request body', function () {",
              "    const responseJson = pm.response.json();",
              "    const requestJson = JSON.parse(pm.request.body.raw || '{}');",
              "",
              "    pm.expect(responseJson).to.have.property('id', requestJson.id);",
              "    pm.expect(responseJson).to.have.property('title', requestJson.title);",
              "    pm.expect(responseJson).to.have.property('body', requestJson.body);",
              "    pm.expect(responseJson).to.have.property('userId', requestJson.userId);",
              "});"
            ],
