              "pm.test(\"Response has the expected top-level keys\", function () {",
              "    pm.expect(jsonData).to.have.property(\"id\");",
              "    pm.expect(jsonData).to.have.property(\"userId\");",
              "    pm.expect(jsonData).to.have.property(\"title\");",
              "    pm.expect(jsonData).to.have.property(\"body\");",
              "});",
              "",
              "pm.test(\"Post id is 1\", function () {",
              "    pm.expect(jsonData.id).to.eql(1);",
              "});",
              "",
              "pm.test(\"userId is present\", function () {",
              "    pm.expect(jsonData.userId).to.exist;",
              "});",
              "",
              "pm.test(\"title is a string\", function () {",
              "    pm.expect(jsonData.title).to.be.a(\"string\");",
              "});",
              "",
              "pm.test(\"body is a string\", function () {",
              "    pm.expect(jsonData.body).to.be.a(\"string\");",
              "});"
